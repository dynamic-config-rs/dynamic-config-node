# Build output.
target/

# Backtraces and profiler output.
*.profraw
perf.data*

# Editors and desktop environments. Kept short on purpose: a repository is
# not the place to enumerate everybody's tools, and a global gitignore is.
.vscode/
.idea/
*.swp
.DS_Store

# The compiled addon, wherever a recipe drops it. Never committed — a
# binary in a git history is a binary somebody has to trust.
*.node
node_modules/

# A lockfile is not part of a library: nothing installing these packages
# reads it, and the one development dependency is a `^` range on purpose.
package-lock.json

# Written by `scripts/pack-platforms.mjs` at publish time: the per-platform
# packages, and the artefacts CI downloads to build them. Both are outputs
# of a release, not inputs to one.
npm/
artefacts/

# The book's build output.
book/book/

# Written by the suites at run time — the tests create the directory and
# their own fixtures, so a checkout carries none of it.
dynamic-config-node/tests/scratch/
